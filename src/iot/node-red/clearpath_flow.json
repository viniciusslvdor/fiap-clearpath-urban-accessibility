[
  {
    "id": "tab_clearpath",
    "type": "tab",
    "label": "ClearPath - Ramp Sentinel",
    "disabled": false,
    "info": "Subscribes to the ESP32 (Wokwi) MQTT events and shows the ramp state on a dashboard. Requires the node-red-dashboard package."
  },
  {
    "id": "broker_hivemq",
    "type": "mqtt-broker",
    "name": "Public HiveMQ",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ui_tab_clearpath",
    "type": "ui_tab",
    "name": "ClearPath",
    "icon": "accessible",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui_group_ramp",
    "type": "ui_group",
    "name": "Ramp Sentinel",
    "tab": "ui_tab_clearpath",
    "order": 1,
    "disp": true,
    "width": "8",
    "collapse": false
  },
  {
    "id": "mqtt_in_sensors",
    "type": "mqtt in",
    "z": "tab_clearpath",
    "name": "Sensor events",
    "topic": "clearpath/fiap-gs/sensors/#",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 160,
    "wires": [["fn_parse", "debug_raw"]]
  },
  {
    "id": "fn_parse",
    "type": "function",
    "z": "tab_clearpath",
    "name": "Interpret event",
    "func": "const p = msg.payload || {};\nconst states = { obstruction: 'BLOCKED', confirmation: 'BLOCKED (confirmed by a citizen)', cleared: 'CLEAR' };\n\n// 1) Ramp state (heartbeat does not change the state)\nif (states[p.event]) {\n  flow.set('state_' + p.device, states[p.event]);\n}\nconst state = flow.get('state_' + p.device) || 'CLEAR';\nconst stateMsg = { payload: `${p.location || p.device}: ${state}` };\n\n// 2) Measured distance (gauge and chart)\nconst distanceMsg = { payload: p.distance_cm, topic: p.device };\n\n// 3) Obstruction counter\nlet n = flow.get('obstructions') || 0;\nif (p.event === 'obstruction') { n += 1; flow.set('obstructions', n); }\n\nreturn [stateMsg, distanceMsg, distanceMsg, { payload: n }];",
    "outputs": 4,
    "noerr": 0,
    "x": 380,
    "y": 160,
    "wires": [["ui_text_state"], ["ui_gauge_distance"], ["ui_chart_distance"], ["ui_text_counter"]]
  },
  {
    "id": "ui_text_state",
    "type": "ui_text",
    "z": "tab_clearpath",
    "group": "ui_group_ramp",
    "order": 1,
    "width": "8",
    "height": "1",
    "name": "State",
    "label": "Ramp state",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "x": 640,
    "y": 100,
    "wires": []
  },
  {
    "id": "ui_gauge_distance",
    "type": "ui_gauge",
    "z": "tab_clearpath",
    "name": "Distance",
    "group": "ui_group_ramp",
    "order": 2,
    "width": "4",
    "height": "3",
    "gtype": "gage",
    "title": "Distance in front of the ramp",
    "label": "cm",
    "format": "{{value | number:0}}",
    "min": 0,
    "max": "400",
    "colors": ["#d03b3b", "#fab219", "#0ca30c"],
    "seg1": "80",
    "seg2": "100",
    "x": 640,
    "y": 140,
    "wires": []
  },
  {
    "id": "ui_chart_distance",
    "type": "ui_chart",
    "z": "tab_clearpath",
    "name": "Distance history",
    "group": "ui_group_ramp",
    "order": 3,
    "width": "8",
    "height": "4",
    "label": "Measured distance (cm)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "step",
    "nodata": "Waiting for the sensor...",
    "ymin": "0",
    "ymax": "400",
    "removeOlder": "1",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "colors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948", "#898781"],
    "x": 650,
    "y": 180,
    "wires": []
  },
  {
    "id": "ui_text_counter",
    "type": "ui_text",
    "z": "tab_clearpath",
    "group": "ui_group_ramp",
    "order": 4,
    "width": "4",
    "height": "1",
    "name": "Counter",
    "label": "Obstructions since start",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 640,
    "y": 220,
    "wires": []
  },
  {
    "id": "debug_raw",
    "type": "debug",
    "z": "tab_clearpath",
    "name": "Received JSON",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "x": 380,
    "y": 240,
    "wires": []
  }
]
